{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "uv run pytest tests/",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run Tests with Coverage",
            "type": "shell",
            "command": "uv run pytest tests/ --cov=custom_components.tibber_prices --cov-report=xml",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "Run Ruff Check and Format",
            "type": "shell",
            "command": "uv run ruff check --fix && uv run ruff format",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}